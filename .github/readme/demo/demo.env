# Shared settings for the README demo. Sourced by stage.sh and record.sh.

# Flask release the demo runs on. Pinned so re-recordings stay comparable.
FLASK_TAG=3.1.3

# The two questions eulix is asked on camera. record.sh substitutes them
# into the tapes as @Q_CLI@ and @Q_AGENT@. Both were picked because eulix
# answers them well on this Flask release: questions that name a bare Python
# method (e.g. "who calls full_dispatch_request") currently get the Flask
# class summary instead of the method (RET-13 in docs/Known-Issues), so avoid
# those until that is fixed.
Q_CLI="How does Flask match a URL to a view function?"
Q_AGENT="Ask eulix how Flask stores the session in a signed cookie. Answer in 3 lines."

# Terminal font. VHS falls back to another font without a warning, so
# record.sh checks that fontconfig resolves this name exactly.
DEMO_FONT="JetBrainsMono Nerd Font"

# Look of the edited video and the raw-export graphics (edit.sh, record.sh
# export, sidebyside.sh --raw). Eulix dark palette, themes/eulix-dark.json.
BG=1a2030 FG=e7e9ee DIM=8b93a7 VIOLET=a78bfa TEAL=5eead4
CAPTION_BAR=64   # caption bar above the terminal, px
INSTALL='bash <(curl -fsSL https://raw.githubusercontent.com/Nurysso/eulix/main/install.sh)'
TITLE='Eulix'
TAGLINE='ranked context for coding agents, over MCP'

# Step captions, in video order.
CAP_1='Set up eulix in a repo'
CAP_2='Index it: parse, call graph, embeddings'
CAP_3='Ask from the CLI: ranked, token-budgeted context'
CAP_4='Your agent asks eulix over MCP'
CAP_5='See the call graph in your browser: eulix vizeulize'
CAP_6='Same question, without and with eulix'

# typed_head_s <text>: seconds from the first visible frame of a Claude tape
# (teaser.tape, sidebyside.tape) until half a second after the question is
# sent: 0.8 s, 40 ms per character, 0.6 s before Enter, then 0.5 s. What
# follows is the wait that gets sped up.
typed_head_s() {
  awk -v n="${#1}" 'BEGIN { printf "%.2f", (800 + n * 40 + 600 + 500) / 1000 }'
}

# Claude Code's usage banner ("You've used 96% of your weekly limit ·
# resets ..."). record.sh and sidebyside.sh warn when a take shows it.
USAGE_BANNER_RE='used [0-9]+% of your|limit · resets|usage limit|limit reached'
