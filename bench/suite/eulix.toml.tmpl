# Generated by bench/eulix_bench.py, do not edit.
# No [project] path (it is absolute) and no [retrievalConfig]: every version
# runs on its own shipped retrieval defaults.
[project]
{engine_line}
DebugConfig = false

[parser]
threads = 8          # fixed so accuracy and parser results don't depend on the machine
prismVersion = 2
verbose = true       # per-phase parser timings in the analyze output

[embeddings]
model = "BAAI/bge-base-en-v1.5"
dimension = 768
engine = "onnx"      # v0.8.3's query-time embedder always uses ONNX
debug = true         # streams the query-time embedder's stderr, which names its device

[llm]
local = true
provider = "ollama"  # provider + max_tokens set the context budget, so both stay fixed
model = "bench"
api_key = ""
baseURL = "http://localhost:11434"
endpoint = ""
temperature = 0.2
max_tokens = 8192

[cache]
enable = false
path = ".eulix/history.db"

[checksum]
change_threshold = 0.1
force_reanalyze_threshold = 0.3
